    {
      "parameters": {
        "jsCode": "const quiz = JSON.parse($input.first().json.text);\n\n// Get original request data from Webhook\nconst webhookData = $('Webhook1').first().json.body;\n\n// Return one item per question\nreturn quiz.map(question => ({\n  json: {\n    ...question,\n\n    topic: webhookData.topic,\n    difficulty: webhookData.difficulty,\n    number_of_questions: webhookData.number_of_questions\n  }\n}));"
